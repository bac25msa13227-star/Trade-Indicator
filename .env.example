MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_changeme
MINIO_SECURE=false

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Airflow ───────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=
