# ── MT5 Account ACC1 (M5 PF3v2 bot — bridge port 5600) ──────────────────────
MT5_LOGIN=your_mt5_account_number_acc1
MT5_PASSWORD=your_mt5_password_acc1
MT5_SERVER=Exness-MT5Trial17

# ── MT5 Account ACC2 (M1 Scalp bot — bridge port 5601) ──────────────────────
MT5_LOGIN_ACC2=your_mt5_account_number_acc2
MT5_PASSWORD_ACC2=your_mt5_password_acc2
MT5_SERVER_ACC2=Exness-MT5Trial14

# ── Telegram ACC1 ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Telegram ACC2 ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN_ACC2=your_telegram_bot_token_acc2
TELEGRAM_CHAT_ID_ACC2=your_telegram_chat_id_acc2

# News Calendar API — đăng ký miễn phí tại https://finnhub.io
# Có actual + estimate → tính surprise thực tế (chính xác hơn rule-based)
# Không bắt buộc: nếu để trống, sẽ dùng ForexFactory + rule-based fallback
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_secret_changeme
POSTGRES_DB=tradedb

# ── MinIO (object storage) ────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_changeme
MINIO_SECURE=false

# ── MLflow (local file — no MLflow server needed) ────────────────────────────
MLFLOW_TRACKING_URI=file:///app/mlruns

# ── Airflow ───────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=changeme_airflow_webserver_secret
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow_changeme

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_changeme

# ── Trading (used by Airflow DAGs) ───────────────────────────
TRADING_ACCOUNT=acc2
FASTAPI_URL=http://api:8000
