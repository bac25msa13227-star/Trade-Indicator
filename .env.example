# MT5 Credentials
MT5_LOGIN=your_acc1_mt5_account_number
MT5_PASSWORD=your_rotated_acc1_mt5_password
MT5_SERVER=your_acc1_mt5_server
MT5_LOGIN_ACC2=your_acc2_mt5_account_number
MT5_PASSWORD_ACC2=your_rotated_acc2_mt5_password
MT5_SERVER_ACC2=your_acc2_mt5_server

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# News Calendar API — đăng ký miễn phí tại https://finnhub.io
# Có actual + estimate → tính surprise thực tế (chính xác hơn rule-based)
# Không bắt buộc: nếu để trống, sẽ dùng ForexFactory + rule-based fallback
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_secret_changeme
POSTGRES_DB=tradedb

# ── MinIO (object storage) ────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_changeme
MINIO_SECURE=false

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Airflow ───────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=changeme_airflow_webserver_secret
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow_changeme

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_changeme

# ── Trading (used by Airflow DAGs) ───────────────────────────
TRADING_ACCOUNT=acc2
FASTAPI_URL=http://api:8000

# mem0 loss-pattern memory (optional, enabled when dependencies + key are available)
MEM0_ENABLED=false
QDRANT_URL=http://qdrant:6333
MEM0_COLLECTION=xauusd_loss_patterns
MEM0_EMBEDDER_PROVIDER=openai
MEM0_LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_optional
