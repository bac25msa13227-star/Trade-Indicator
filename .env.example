# MT5 Credentials
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Exness-MT5Trial17
# Optional terminal path (Windows bridge host)
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# MT5 Bridge endpoints used by docker live services
# If Docker runs on same Windows host as bridge: keep host.docker.internal
# If Docker runs on another machine (macOS/Linux): set to Windows LAN IP, e.g. http://192.168.1.50:5600
MT5_BRIDGE_URL_ACC1=http://host.docker.internal:5600
MT5_BRIDGE_URL_ACC2=http://host.docker.internal:5601

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Per-account Telegram (recommended for live_acc1/live_acc2)
TELEGRAM_BOT_TOKEN_ACC1=
TELEGRAM_CHAT_ID_ACC1=
TELEGRAM_BOT_TOKEN_ACC2=
TELEGRAM_CHAT_ID_ACC2=

# News Calendar API — đăng ký miễn phí tại https://finnhub.io
# Có actual + estimate → tính surprise thực tế (chính xác hơn rule-based)
# Không bắt buộc: nếu để trống, sẽ dùng ForexFactory + rule-based fallback
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_secret_changeme
POSTGRES_DB=tradedb

# ── MinIO (object storage) ────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_changeme
MINIO_SECURE=false

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Airflow ───────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=changeme_airflow_webserver_secret
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow_changeme

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_changeme

# ── Trading (used by Airflow DAGs) ───────────────────────────
TRADING_ACCOUNT=acc2
FASTAPI_URL=http://api:8000
